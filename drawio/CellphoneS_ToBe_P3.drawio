        <mxCell id="Participant_KH" value="Khách hàng" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="160" y="1178" width="2660" height="60" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_1" value="SƠ ĐỒ CHI TIẾT 3 (TO-BE): Chuyển thiết bị đến nơi xử lý&lt;br&gt;Mô hình To-Be đề xuất, dựng từ các điểm nghẽn tiềm ẩn của mô hình As-Is. Các điểm nghẽn chưa được đo, nên mỗi thay đổi cần được kiểm chứng trước khi áp dụng. Đây không phải quy trình chính thức của CellphoneS." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=626;" vertex="1" parent="1"><mxGeometry x="160" y="30" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_2" value="Chú giải" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=66;" vertex="1" parent="1"><mxGeometry x="840" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_3" value="Ô nền xanh lá: bước mới" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=166;" vertex="1" parent="1"><mxGeometry x="940" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_4" value="Ô nền vàng: bước As-Is được thay đổi" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=236;" vertex="1" parent="1"><mxGeometry x="1140" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_5" value="Ghi chú đỏ: nội dung thay đổi so với As-Is" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=266;" vertex="1" parent="1"><mxGeometry x="1410" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_6" value="Ghi chú xanh ngọc: cần doanh nghiệp quyết định" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=296;" vertex="1" parent="1"><mxGeometry x="940" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_7" value="Ghi chú cam: cần khảo sát trước khi áp dụng" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=276;" vertex="1" parent="1"><mxGeometry x="1270" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_8" value="Ghi chú xanh dương: mốc thời gian được lưu lại" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=286;" vertex="1" parent="1"><mxGeometry x="1580" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Msg_31" value="Thiết bị và hồ sơ yêu cầu" style="html=1;dashed=1;dashPattern=8 4;endArrow=block;endFill=0;startArrow=oval;startFill=0;startSize=4;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.383459;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="1" source="T2h" target="Participant_HANG"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="-49" y="-112" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Msg_32" value="Phản hồi tiếp nhận, mã tiếp nhận" style="html=1;dashed=1;dashPattern=8 4;endArrow=block;endFill=0;startArrow=oval;startFill=0;startSize=4;edgeStyle=orthogonalEdgeStyle;exitX=0.447368;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="1" source="Participant_HANG" target="C1"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="41.5" y="-123" as="offset"/></mxGeometry></mxCell>
