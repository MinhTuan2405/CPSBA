        <mxCell id="Flow_22" value="Cần bổ sung&lt;br&gt;thông tin" style="html=1;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="Participant_CPS" source="g3" target="T5"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="39.5" y="8" as="offset"/></mxGeometry></mxCell>
