        <mxCell id="Lane_SC" value="Bộ phận sửa chữa (Điện Thoại Vui; CareS với thiết bị Apple)" style="swimlane;html=1;startSize=30;fontStyle=0;collapsible=0;swimlaneLine=0;fillColor=none;whiteSpace=wrap;horizontal=0;" vertex="1" parent="Participant_CPS"><mxGeometry x="30" y="530" width="2630" height="320" as="geometry"></mxGeometry></mxCell>
        <mxCell id="T3" value="Xem hồ sơ và trả lời cửa hàng" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;" vertex="1" parent="Lane_SC"><mxGeometry x="1090" y="60" width="140" height="80" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g3" value="Trả lời&lt;br&gt;về hồ sơ?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_SC"><mxGeometry x="1305" y="75" width="50" height="50" as="geometry"><mxPoint x="-33" y="-9" as="offset"/></mxGeometry></mxCell>
        <mxCell id="T8" value="Xác nhận đã nhận thiết bị" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;" vertex="1" parent="Lane_SC"><mxGeometry x="1770" y="60" width="140" height="80" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_39" value="Cần khảo sát: bộ phận sửa chữa có ở cùng địa điểm với cửa hàng không. Nếu có thì bàn giao ngay sau khi lập phiếu, không cần gom chuyến." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="1090" y="164" width="10" height="113" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_41" value="Hai mốc thời gian được lưu: cửa hàng đã giao, nơi xử lý đã nhận. Máy đã giao mà chưa có xác nhận nhận được rà soát mỗi ngày." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_SC"><mxGeometry x="1780" y="168" width="10" height="70" as="geometry"></mxGeometry></mxCell>
