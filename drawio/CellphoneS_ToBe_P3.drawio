        <mxCell id="Note_34" value="Nơi xử lý đã được chọn tại quầy. Ở đây chỉ xác nhận lại và kiểm hồ sơ theo danh sách kiểm trước khi gửi." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="430" y="168" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_35" value="Thiết bị còn ở cửa hàng, nên được trả lại cho khách ngay (sơ đồ chi tiết 5)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="435" y="410" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_36" value="Danh sách kiểm hồ sơ riêng cho từng hãng. Cần khảo sát: cách gửi, người phụ trách, hồ sơ mỗi hãng yêu cầu." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="800" y="48" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_37" value="Mã tiếp nhận của hãng được lưu vào hồ sơ. Cần khảo sát: hãng có cấp mã hay không." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="Lane_CH"><mxGeometry x="1175" y="76" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_38" value="Hồ sơ đi trước thiết bị: bộ phận sửa chữa trả lời khi thiết bị còn ở cửa hàng, nên máy không phải đi rồi quay về." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="940" y="288" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_40" value="Chuyển theo lịch cố định, mỗi ca có một người phụ trách giao nhận. Cần doanh nghiệp quyết định: số chuyến mỗi ngày và giờ chốt." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=156;" vertex="1" parent="Lane_CH"><mxGeometry x="1620" y="273" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_42" value="Khách được báo ngay khi nơi xử lý đã nhận máy, không phải tự hỏi." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="2300" y="196" width="10" height="56" as="geometry"></mxGeometry></mxCell>
