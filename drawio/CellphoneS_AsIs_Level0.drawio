        <mxCell id="Note_47" value="Nhóm nghiên cứu: kiểm tra bảo hành ngay tại quầy, trước khi nhận máy. Kết quả chỉ là phân loại sơ bộ." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=156;" vertex="1" parent="Lane_CH"><mxGeometry x="235" y="358" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_48" value="Có nguồn (Chính sách bảo hành CellphoneS): đổi mới trong 30 ngày khi lỗi phần cứng từ nhà sản xuất." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="455" y="35" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_49" value="Nhóm nghiên cứu: phiếu tiếp nhận được lập cho mọi thiết bị, kể cả lỗi sửa nhanh." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=146;" vertex="1" parent="Lane_CH"><mxGeometry x="620" y="388" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_50" value="Nhóm nghiên cứu: cửa hàng tự xử lý lỗi đơn giản như thay miếng dán màn hình, lỗi phần mềm. Cần khảo sát: danh mục lỗi." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="1100" y="27" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_51" value="Có: cửa hàng không xử lý được và khách đồng ý chuyển. Không: đã xử lý xong, hoặc khách không tiếp tục." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=186;" vertex="1" parent="Lane_CH"><mxGeometry x="1355" y="38" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_52" value="Cần khảo sát: cách chuyển thiết bị, người phụ trách, mốc giao và mốc nhận." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1330" y="368" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_53" value="Cần khảo sát: không có nguồn về quy trình bên trong của hãng; khi hãng từ chối bảo hành thì xử lý thế nào." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=176;" vertex="1" parent="Lane_CH"><mxGeometry x="1855" y="356" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_55" value="Có nguồn (Quy định tiếp nhận của CellphoneS): phiếu có giá trị lấy máy trong 60 ngày." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=171;" vertex="1" parent="Lane_CH"><mxGeometry x="2845" y="465" width="10" height="56" as="geometry"></mxGeometry></mxCell>
