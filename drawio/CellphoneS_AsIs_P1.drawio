        <mxCell id="E_ok" value="Khách đồng ý giao máy" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="1652" y="172" width="36" height="36" as="geometry"><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="E_ve" value="Khách mang máy về" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="1652" y="292" width="36" height="36" as="geometry"><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Note_22" value="Có nguồn (Trang kiểm tra thời hạn bảo hành CellphoneS): khách có thể gọi tổng đài 1800.2097 trước khi đến. Cần khảo sát: cuộc gọi có tạo hồ sơ không." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=141;" vertex="1" parent="Lane_CH"><mxGeometry x="85" y="266" width="10" height="113" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_23" value="Cần khảo sát: cách ghi nhận yêu cầu ở bước này; thời gian khách chờ được phục vụ." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="270" y="258" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_24" value="Nhóm nghiên cứu: tra cứu ngay tại quầy, khi khách còn giữ máy." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="460" y="66" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_25" value="Có nguồn (Trang kiểm tra thời hạn bảo hành CellphoneS): tra cứu bằng IMEI hoặc Seri. Cần khảo sát: công cụ nhân viên thực sự dùng; cách xử lý khi không tìm thấy thông tin." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="440" y="258" width="10" height="128" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_26" value="Có nguồn (Chính sách bảo hành CellphoneS): máy mới bảo hành tại hãng; máy đã kích hoạt theo hãng rồi đến CellphoneS/ Điện Thoại Vui; máy cũ 6 tháng tại CellphoneS/ Điện Thoại Vui." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="610" y="258" width="10" height="142" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_27" value="Đo thời gian 1: từ khi khách nêu yêu cầu đến khi có hướng xử lý sơ bộ." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="800" y="66" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_28" value="Bốn hướng: xử lý nhanh tại cửa hàng; sửa chữa trong hệ thống; gửi bảo hành hãng; đổi mới. Cần khảo sát: quy tắc phân tuyến chi tiết." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="780" y="258" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_29" value="Có nguồn (Chính sách bảo hành CellphoneS): đổi mới trong 30 ngày khi lỗi phần cứng từ nhà sản xuất. Cần khảo sát: ai kết luận lỗi thuộc nhà sản xuất." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=186;" vertex="1" parent="Lane_CH"><mxGeometry x="1100" y="378" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_30" value="Chỉ là phân loại sơ bộ. Kết luận sửa miễn phí hay có phí chỉ có sau khi kiểm tra kỹ thuật (sơ đồ chi tiết 4)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="990" y="38" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_31" value="Gồm cả trường hợp khách tự mang máy đến trung tâm bảo hành của hãng. Khách chưa giao máy nên không có thủ tục trả máy." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=176;" vertex="1" parent="Lane_CH"><mxGeometry x="1540" y="378" width="10" height="84" as="geometry"></mxGeometry></mxCell>
