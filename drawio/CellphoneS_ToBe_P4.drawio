        <mxCell id="Note_1" value="SƠ ĐỒ CHI TIẾT 4 (TO-BE): Kiểm tra kỹ thuật và sửa chữa&lt;br&gt;Mô hình To-Be đề xuất, dựng từ các điểm nghẽn tiềm ẩn của mô hình As-Is. Các điểm nghẽn chưa được đo, nên mỗi thay đổi cần được kiểm chứng trước khi áp dụng. Đây không phải quy trình chính thức của CellphoneS." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=626;" vertex="1" parent="1"><mxGeometry x="160" y="30" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_2" value="Chú giải" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=66;" vertex="1" parent="1"><mxGeometry x="840" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_3" value="Ô nền xanh lá: bước mới" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=166;" vertex="1" parent="1"><mxGeometry x="940" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_4" value="Ô nền vàng: bước As-Is được thay đổi" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=236;" vertex="1" parent="1"><mxGeometry x="1140" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_5" value="Ghi chú đỏ: nội dung thay đổi so với As-Is" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=266;" vertex="1" parent="1"><mxGeometry x="1410" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_6" value="Ghi chú xanh ngọc: cần doanh nghiệp quyết định" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=296;" vertex="1" parent="1"><mxGeometry x="940" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_7" value="Ghi chú cam: cần khảo sát trước khi áp dụng" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=276;" vertex="1" parent="1"><mxGeometry x="1270" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_8" value="Ghi chú xanh dương: mốc thời gian được lưu lại" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=286;" vertex="1" parent="1"><mxGeometry x="1580" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_47" value="Phạm vi: sửa chữa trong hệ thống, tại Điện Thoại Vui hoặc CareS. Trường hợp gửi bảo hành tại hãng: xem sơ đồ tổng quan." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=746;" vertex="1" parent="1"><mxGeometry x="160" y="118" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Msg_39" value="Báo giá, điều kiện bảo hành, thời gian" style="html=1;dashed=1;dashPattern=8 4;endArrow=block;endFill=0;startArrow=oval;startFill=0;startSize=4;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.277174;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="1" source="T4" target="Participant_KH"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="-52" y="-164" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Msg_40" value="Đồng ý hoặc từ chối" style="html=1;dashed=1;dashPattern=8 4;endArrow=block;endFill=0;startArrow=oval;startFill=0;startSize=4;edgeStyle=orthogonalEdgeStyle;exitX=0.369565;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="1" source="Participant_KH" target="C1"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="45" y="-176" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Msg_41" value="Phương án và ngày dự kiến" style="html=1;dashed=1;dashPattern=8 4;endArrow=block;endFill=0;startArrow=oval;startFill=0;startSize=4;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.508152;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="1" source="Tb" target="Participant_KH"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="-42.5" y="-224" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Msg_42" value="Đã xử lý xong, ngày có tại cửa hàng" style="html=1;dashed=1;dashPattern=8 4;endArrow=block;endFill=0;startArrow=oval;startFill=0;startSize=4;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.877717;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="1" source="T7" target="Participant_KH"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="45" y="-224" as="offset"/></mxGeometry></mxCell>
