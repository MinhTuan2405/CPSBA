        <mxCell id="Note_48" value="Lỗi đơn giản và lỗi phức tạp đi hai hàng chờ riêng. Thứ tự tính từ lúc khách giao máy tại cửa hàng." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="260" y="273" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_49" value="Mốc thời gian được lưu: lúc nhận máy, lúc chẩn đoán xong, lúc gửi báo giá, lúc khách trả lời, lúc sửa xong." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="80" y="501" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_50" value="Linh kiện được kiểm tra ngay lúc này, nên thời gian chờ linh kiện có sẵn trong báo giá." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="600" y="493" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_51" value="Không cần hỏi khi máy được bảo hành, hoặc khi chi phí nằm trong mức khách đã chấp nhận tại quầy. Chỉ hỏi lại khi chi phí vượt mức đó." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=176;" vertex="1" parent="Lane_SC"><mxGeometry x="950" y="500" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_52" value="Báo giá gửi qua kênh khách bấm đồng ý hoặc từ chối được ngay; câu trả lời được lưu làm xác nhận. Có thể giữ chỗ linh kiện trong lúc chờ." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="800" y="138" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_53" value="Cần doanh nghiệp quyết định: hạn phản hồi và số lần nhắc. Hết hạn thì trả máy chưa sửa." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="Lane_SC"><mxGeometry x="1090" y="55" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_54" value="Khách được báo cả khi không phát sinh chi phí: máy được sửa theo phương án nào, dự kiến xong ngày nào." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="1630" y="493" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_55" value="Cần khảo sát: có phải chờ linh kiện không, chờ bao lâu. Máy còn dùng được thì khách có thể nhận lại trong lúc chờ." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_SC"><mxGeometry x="1930" y="595" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_56" value="Danh sách kiểm gồm lỗi ban đầu theo mô tả trên phiếu và các tính năng cơ bản." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="2470" y="287" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_57" value="Cần doanh nghiệp quyết định: số lần sửa lại tối đa. Hết số lần thì người có kinh nghiệm hơn xem xét; nếu đổi chi phí thì hỏi lại khách." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_SC"><mxGeometry x="2460" y="613" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_58" value="Thông tin đi trước thiết bị: cửa hàng và khách biết ngay khi sửa xong, kèm ngày dự kiến máy có tại cửa hàng." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="3212" y="273" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_59" value="Chuyến mang máy mới đến cũng mang máy đã xong về. Giao và nhận đều được xác nhận." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="3360" y="493" width="10" height="70" as="geometry"></mxGeometry></mxCell>
