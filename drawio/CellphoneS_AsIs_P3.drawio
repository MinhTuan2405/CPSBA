        <mxCell id="Note_27" value="Đo thời gian 3: từ khi có phiếu tiếp nhận đến khi cửa hàng giao thiết bị đi (mốc A)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="90" y="164" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_28" value="Có nguồn (Chính sách bảo hành CellphoneS): nơi bảo hành theo nhóm sản phẩm. Cần khảo sát: ai có quyền chỉ định nơi xử lý." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="450" y="113" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_29" value="Thiết bị được trả lại cho khách ở trạng thái chưa xử lý (sơ đồ chi tiết 5)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=156;" vertex="1" parent="Lane_CH"><mxGeometry x="620" y="456" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_30" value="Cần khảo sát: hồ sơ gồm những gì; có bước xác nhận hồ sơ đủ thông tin không." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="Lane_CH"><mxGeometry x="785" y="142" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_31" value="Mốc A: cửa hàng đã giao thiết bị. Có nguồn (Chính sách bảo hành CellphoneS): cửa hàng tiếp nhận để gửi máy bảo hành chính hãng. Cần khảo sát: cách gửi, người phụ trách." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="980" y="84" width="10" height="128" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_32" value="Mốc A: cửa hàng đã giao thiết bị. Cần khảo sát: bộ phận sửa chữa ở cùng địa điểm hay phải vận chuyển; hình thức xác nhận bàn giao." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="975" y="460" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_33" value="Mốc B: nơi xử lý đã nhận thiết bị. Cần khảo sát: hai mốc A và B có được ghi nhận trên hệ thống không." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1345" y="130" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_35" value="Cần khảo sát: toàn bộ các tình huống ngoại lệ ở bước này. Mô hình giả định sau khi bổ sung thông tin thì nơi xử lý tiếp nhận." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=236;" vertex="1" parent="Lane_CH"><mxGeometry x="1780" y="36" width="10" height="56" as="geometry"></mxGeometry></mxCell>
