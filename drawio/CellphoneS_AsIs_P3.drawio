        <mxCell id="Note_36" value="Mô hình không giả định bộ phận kho vận, cấp duyệt của quản lý, biên bản giao nhận hay phần mềm quản lý vận chuyển." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=746;" vertex="1" parent="1"><mxGeometry x="160" y="96" width="10" height="27" as="geometry"></mxGeometry></mxCell>
