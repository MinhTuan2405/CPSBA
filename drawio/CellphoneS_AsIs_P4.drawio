        <mxCell id="T7" value="Ghi nhận kết quả xử lý" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;" vertex="1" parent="Lane_SC"><mxGeometry x="2450" y="275" width="140" height="80" as="geometry"></mxGeometry></mxCell>
        <mxCell id="T9" value="Chuyển kết quả và thiết bị về cửa hàng" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;" vertex="1" parent="Lane_SC"><mxGeometry x="2620" y="275" width="140" height="80" as="geometry"></mxGeometry></mxCell>
        <mxCell id="E" value="Kết quả và thiết bị đã về cửa hàng" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_SC"><mxGeometry x="2842" y="297" width="36" height="36" as="geometry"><mxPoint x="0.5" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="D_kq" value="Kết quả kiểm tra" style="shape=mxgraph.bpmn.data2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;size=15;html=1;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_SC"><mxGeometry x="462" y="375" width="36" height="50" as="geometry"><mxPoint x="65.5" y="-39" as="offset"/></mxGeometry></mxCell>
        <mxCell id="D_bg" value="Báo giá" style="shape=mxgraph.bpmn.data2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;size=15;html=1;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_SC"><mxGeometry x="927" y="247" width="36" height="50" as="geometry"><mxPoint x="44" y="-39" as="offset"/></mxGeometry></mxCell>
        <mxCell id="D_kqxl" value="Kết quả xử lý" style="shape=mxgraph.bpmn.data2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;size=15;html=1;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_SC"><mxGeometry x="2502" y="375" width="36" height="50" as="geometry"><mxPoint x="57" y="-39" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Note_36" value="Đo thời gian 5: từ khi nhận thiết bị đến khi chẩn đoán xong." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="90" y="401" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_37" value="Có nguồn (Trang chủ Điện Thoại Vui): kiểm tra thiết bị. Có nguồn (Hướng dẫn của CareS): kiểm tra ngoại quan." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="260" y="163" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_38" value="Có nguồn (Hướng dẫn của CareS): chẩn đoán bằng phần mềm chuyên dụng. Chỉ áp dụng cho CareS." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="430" y="163" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_39" value="Bảo hành theo chính sách, hoặc sửa chữa có phí. Phân loại sơ bộ tại quầy được xác nhận hoặc thay đổi ở bước này." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="600" y="148" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_40" value="Có nguồn (Điện Thoại Vui, CareS): báo giá và chỉ sửa sau khi khách đồng ý, công bố cho khách đến trực tiếp. Cần khảo sát: ai liên hệ khách, qua kênh nào, lưu xác nhận ra sao." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_SC"><mxGeometry x="740" y="57" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_41" value="Đo thời gian 6: từ khi báo phương án đến khi khách phản hồi." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=116;" vertex="1" parent="Lane_SC"><mxGeometry x="1020" y="87" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_42" value="Khách từ chối: dừng sửa chữa, trả thiết bị chưa sửa. Không có nguồn về hậu quả khi từ chối, ví dụ phí kiểm tra." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=176;" vertex="1" parent="Lane_SC"><mxGeometry x="1390" y="183" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_43" value="Cần khảo sát: việc chờ linh kiện chưa có nguồn. Đo thời gian 7: thời gian chờ linh kiện, nếu phát sinh." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=151;" vertex="1" parent="Lane_SC"><mxGeometry x="1435" y="485" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_44" value="Cần khảo sát: lỗi phức tạp có phải chuyển lên trung tâm sửa chữa của Apple không (chưa có nguồn)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="1790" y="163" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_45" value="Đo thời gian 8: thời gian sửa chữa." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=116;" vertex="1" parent="Lane_SC"><mxGeometry x="1805" y="367" width="10" height="41" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_46" value="Có nguồn (Điện Thoại Vui): kiểm tra hoàn thiện. Có nguồn (CareS): kiểm tra lại chức năng liên quan lỗi ban đầu và tính năng cơ bản." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_SC"><mxGeometry x="1960" y="148" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_47" value="Cần khảo sát: khi kiểm tra chưa đạt thì sửa lại, đổi phương án hay dừng. Mô hình có lối thoát khi không thể xử lý, không lặp vô hạn." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=186;" vertex="1" parent="Lane_SC"><mxGeometry x="2200" y="492" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_48" value="Kết quả gồm: đã sửa chữa hoặc bảo hành; khách từ chối; không thể xử lý." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="Lane_SC"><mxGeometry x="2480" y="177" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_49" value="Cần khảo sát: cách chuyển thiết bị về cửa hàng, cách báo, thời điểm cập nhật trạng thái. Đo thời gian 9: từ khi sửa xong đến khi thiết bị sẵn sàng trả tại cửa hàng." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=176;" vertex="1" parent="Lane_SC"><mxGeometry x="2660" y="148" width="10" height="99" as="geometry"></mxGeometry></mxCell>
