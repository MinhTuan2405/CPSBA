        <mxCell id="Note_1" value="SƠ ĐỒ CHI TIẾT 4: Kiểm tra kỹ thuật và sửa chữa&lt;br&gt;Mô hình As-Is sơ bộ, dựng từ tài liệu công khai và hiểu biết của nhóm nghiên cứu. Đây không phải quy trình nội bộ chính thức của CellphoneS." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=606;" vertex="1" parent="1"><mxGeometry x="160" y="30" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_2" value="Chú giải màu ghi chú" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="1"><mxGeometry x="820" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_3" value="Xanh lá: có nguồn công khai" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=176;" vertex="1" parent="1"><mxGeometry x="990" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_4" value="Cam: cần khảo sát" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="1"><mxGeometry x="1200" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_5" value="Tím: do nhóm nghiên cứu đưa ra" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=196;" vertex="1" parent="1"><mxGeometry x="1360" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_6" value="Xanh dương: khoảng thời gian cần đo" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=226;" vertex="1" parent="1"><mxGeometry x="1590" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_50" value="Phạm vi: sửa chữa trong hệ thống, dựa trên quy trình Điện Thoại Vui và CareS công bố cho khách đến trực tiếp. Trường hợp gửi hãng: xem sơ đồ tổng quan. Có nguồn (Hướng dẫn của CareS), chỉ để tham khảo: một số lỗi iPhone 1 đến 2 giờ, MacBook 7 đến 14 ngày; không dùng làm số liệu chung." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=986;" vertex="1" parent="1"><mxGeometry x="160" y="96" width="10" height="41" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Msg_31" value="Phương án, chi phí, thời gian" style="html=1;dashed=1;dashPattern=8 4;endArrow=block;endFill=0;startArrow=oval;startFill=0;startSize=4;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.34;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="1" source="T4" target="Participant_KH"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="-45" y="-109" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Msg_32" value="Đồng ý hoặc từ chối" style="html=1;dashed=1;dashPattern=8 4;endArrow=block;endFill=0;startArrow=oval;startFill=0;startSize=4;edgeStyle=orthogonalEdgeStyle;exitX=0.396667;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="1" source="Participant_KH" target="C1"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="45" y="-121" as="offset"/></mxGeometry></mxCell>
