        <mxCell id="Note_58" value="Thay đổi chính: khách khai báo trước; nơi xử lý được chọn ngay tại quầy theo bảng quy tắc; thỏa thuận trước mức chi phí." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=156;" vertex="1" parent="Lane_CH"><mxGeometry x="235" y="368" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_59" value="Thay đổi chính: khách chuẩn bị máy từ trước; mẫu tiếp nhận thống nhất; phiếu có mã điện tử." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="620" y="398" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_60" value="Chỉ xử lý nhanh các lỗi có trong danh mục, trong thời gian giới hạn. Lỗi ngoài danh mục thì chuyển đi ngay." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="1100" y="51" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_61" value="Điểm nối: luồng đi tiếp từ điểm nối cùng tên ở cuối sơ đồ, thay cho một đường nối dài. Thiết bị quay lại theo đường ưu tiên, không xếp hàng lại từ đầu." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="1190" y="461" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_62" value="Thay đổi chính: hồ sơ đi trước thiết bị; chuyển theo lịch cố định; xác nhận ở cả hai đầu." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="Lane_CH"><mxGeometry x="1512" y="368" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_63" value="Mới: máy đang ở hãng được rà soát theo kỳ, có người phụ trách. Cần doanh nghiệp quyết định: chu kỳ rà soát." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="1790" y="483" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_64" value="Hãng từ chối bảo hành: cửa hàng báo khách ngay, kèm lý do của hãng và báo giá sửa có phí trong hệ thống (sơ đồ chi tiết 5)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="2192" y="361" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_66" value="Thay đổi chính: cửa hàng thử lại máy trước khi báo khách; nhắc theo mốc; có cách xác minh thay thế khi mất phiếu; có đường quay lại sửa." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="2670" y="123" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_67" value="Cần doanh nghiệp quyết định: mốc bắt đầu tính 60 ngày và số lần nhắc trước khi tháo gỡ." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=156;" vertex="1" parent="Lane_CH"><mxGeometry x="3190" y="471" width="10" height="70" as="geometry"></mxGeometry></mxCell>
