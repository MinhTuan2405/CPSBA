        <mxCell id="Lane_SC" value="Bộ phận sửa chữa (Điện Thoại Vui; CareS với thiết bị Apple)" style="swimlane;html=1;startSize=30;fontStyle=0;collapsible=0;swimlaneLine=0;fillColor=none;whiteSpace=wrap;horizontal=0;" vertex="1" parent="Participant_CPS"><mxGeometry x="30" y="625" width="3480" height="280" as="geometry"></mxGeometry></mxCell>
        <mxCell id="P4" value="4. Kiểm tra kỹ thuật và sửa chữa" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;isLoopSub=1;" vertex="1" parent="Lane_SC"><mxGeometry x="2445" y="55" width="150" height="90" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_65" value="Thay đổi chính: báo giá có hạn phản hồi; linh kiện được kiểm tra khi chẩn đoán; kết quả được báo trước khi thiết bị về." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=216;" vertex="1" parent="Lane_SC"><mxGeometry x="2500" y="167" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_65_assoc" value="" style="html=1;dashed=1;dashPattern=1 4;endArrow=none;exitX=0;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="Lane_SC" source="Note_65" target="P4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Flow_27" value="Bộ phận sửa chữa đã nhận" style="html=1;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="Participant_CPS" source="g4" target="P4"><mxGeometry width="90" relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="725"/></Array><mxPoint x="-132.5" y="-392" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Flow_36" value="" style="html=1;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="Participant_CPS" source="P4" target="mB"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2720" y="725"/></Array></mxGeometry></mxCell>
        <mxCell id="Participant_HANG" value="Trung tâm bảo hành của hãng" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="160" y="1278" width="3510" height="60" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_1" value="SƠ ĐỒ TỔNG QUAN (TO-BE): Tiếp nhận và xử lý yêu cầu bảo hành, sửa chữa thiết bị qua cửa hàng CellphoneS&lt;br&gt;Mô hình To-Be đề xuất, dựng từ các điểm nghẽn tiềm ẩn của mô hình As-Is. Các điểm nghẽn chưa được đo, nên mỗi thay đổi cần được kiểm chứng trước khi áp dụng. Đây không phải quy trình chính thức của CellphoneS." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=626;" vertex="1" parent="1"><mxGeometry x="160" y="30" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_2" value="Chú giải" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=66;" vertex="1" parent="1"><mxGeometry x="840" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_3" value="Ô nền xanh lá: bước mới" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=166;" vertex="1" parent="1"><mxGeometry x="940" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_4" value="Ô nền vàng: bước As-Is được thay đổi" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=236;" vertex="1" parent="1"><mxGeometry x="1140" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_5" value="Ghi chú đỏ: nội dung thay đổi so với As-Is" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=266;" vertex="1" parent="1"><mxGeometry x="1410" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_6" value="Ghi chú xanh ngọc: cần doanh nghiệp quyết định" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=296;" vertex="1" parent="1"><mxGeometry x="940" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_7" value="Ghi chú cam: cần khảo sát trước khi áp dụng" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=276;" vertex="1" parent="1"><mxGeometry x="1270" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_8" value="Ghi chú xanh dương: mốc thời gian được lưu lại" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=286;" vertex="1" parent="1"><mxGeometry x="1580" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_57" value="Theo dõi trạng thái xuyên suốt: một mã hồ sơ từ phiếu tiếp nhận đi suốt quy trình ở cả cửa hàng và bộ phận sửa chữa; trạng thái đổi theo chính thao tác nghiệp vụ; khách được báo ở các mốc chính; thời điểm mỗi mốc được lưu lại. Cần khảo sát: hệ thống hiện tại đã làm được phần nào." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=986;" vertex="1" parent="1"><mxGeometry x="160" y="112" width="10" height="41" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Msg_45" value="Yêu cầu bảo hành, sửa chữa" style="html=1;dashed=1;dashPattern=8 4;endArrow=block;endFill=0;startArrow=oval;startFill=0;startSize=4;edgeStyle=orthogonalEdgeStyle;exitX=0.048433;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=11;whiteSpace=wrap;verticalAlign=top;" edge="1" parent="1" source="Participant_KH" target="S"><mxGeometry width="90" relative="1" as="geometry"><mxPoint x="-46" y="-171" as="offset"/></mxGeometry></mxCell>
