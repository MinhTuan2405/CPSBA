        <mxCell id="m2" value="" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fontSize=11;" vertex="1" parent="Lane_CH"><mxGeometry x="3685" y="290" width="50" height="50" as="geometry"></mxGeometry></mxCell>
        <mxCell id="T9" value="Hoàn tất yêu cầu, lưu thời điểm các mốc" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;" vertex="1" parent="Lane_CH"><mxGeometry x="3810" y="275" width="140" height="80" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g6" value="Thiết bị đã&lt;br&gt;được sửa?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="4025" y="290" width="50" height="50" as="geometry"><mxPoint x="-35.5" y="-79" as="offset"/></mxGeometry></mxCell>
        <mxCell id="E1" value="Đã trả thiết bị sau khi sửa chữa, bảo hành hoặc thay thế" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="4202" y="297" width="36" height="36" as="geometry"><mxPoint x="0.5" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="E2" value="Đã trả thiết bị chưa sửa" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="4202" y="417" width="36" height="36" as="geometry"><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="D_phieu" value="Phiếu tiếp nhận hoặc mã phiếu" style="shape=mxgraph.bpmn.data2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;size=15;html=1;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="1527" y="195" width="36" height="50" as="geometry"><mxPoint x="63.5" y="-46" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Note_61" value="Cửa hàng thử lại đúng lỗi ban đầu trước khi báo khách. Lỗi còn lại được phát hiện sớm hơn một bước, khách không phải đến vô ích." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="250" y="148" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_62" value="Mốc thời gian được lưu: lúc máy về cửa hàng, lúc báo khách thành công, lúc khách nhận máy." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="80" y="401" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_63" value="Hãng từ chối bảo hành: khách nhận lý do của hãng và báo giá sửa có phí trong hệ thống ngay trong thông báo, để quyết định trong một lần liên hệ." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=146;" vertex="1" parent="Lane_CH"><mxGeometry x="560" y="28" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_64" value="Sửa lại được đánh dấu riêng, để đếm được số lần làm lại." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="600" y="503" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_66" value="Cần doanh nghiệp quyết định: mốc bắt đầu tính 60 ngày (đề xuất: từ lúc báo khách thành công), và việc rà soát trước khi tháo gỡ." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="1270" y="503" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_67" value="Thay cho việc không trả máy khi mất phiếu: đối chiếu mã gửi về số điện thoại đã đăng ký, giấy tờ tùy thân và số IMEI. Cần doanh nghiệp quyết định, vì thay đổi quy định đã công bố." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=186;" vertex="1" parent="Lane_CH"><mxGeometry x="1852" y="28" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_68" value="Hồ sơ chưa trả được có người phụ trách và hạn xử lý." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=116;" vertex="1" parent="Lane_CH"><mxGeometry x="2165" y="89" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_69" value="Nhân viên cùng khách kiểm tra lỗi ban đầu và các tính năng cơ bản; khách xác nhận kết quả." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="Lane_CH"><mxGeometry x="2362" y="163" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_70" value="Khách không nhận vì còn lỗi, hoặc chọn sửa có phí sau khi hãng từ chối: thiết bị quay lại bộ phận sửa chữa theo đường ưu tiên, không xếp hàng lại từ đầu." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="2630" y="503" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_71" value="Khách có thể thanh toán trước qua kênh trực tuyến khi nhận thông báo." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="3042" y="177" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_72" value="Thời điểm của từng mốc được lưu khi đóng hồ sơ, làm số liệu cho các khoảng thời gian cần đo." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="3830" y="177" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_73" value="Không đồng nhất &quot;đã bàn giao&quot; với &quot;đã sửa chữa thành công&quot;." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="3880" y="388" width="10" height="56" as="geometry"></mxGeometry></mxCell>
