        <mxCell id="Note_42" value="Đo thời gian 9: từ khi sửa xong đến khi thiết bị sẵn sàng trả tại cửa hàng." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="260" y="71" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_43" value="Cần khảo sát: cách cửa hàng nhận lại thiết bị từ nơi xử lý." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="260" y="263" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_44" value="Cần khảo sát: cách đối chiếu kết quả và xác định thiết bị sẵn sàng trả." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="430" y="263" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_45" value="Đo thời gian 10: từ khi thiết bị sẵn sàng đến khi khách được báo." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="Lane_CH"><mxGeometry x="490" y="71" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_46" value="Cần khảo sát: ai báo, kênh nào, khi nào coi là đã báo. Khách đang chờ tại cửa hàng (xử lý nhanh) thì được trả máy ngay." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="600" y="263" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_47" value="Đo thời gian 11: từ khi khách được báo đến khi khách nhận máy." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=116;" vertex="1" parent="Lane_CH"><mxGeometry x="1010" y="73" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_48" value="Có nguồn (Quy định tiếp nhận của CellphoneS): phiếu có giá trị lấy máy trong 60 ngày; sau đó tháo gỡ linh kiện để tái chế. Cần khảo sát: mốc bắt đầu tính 60 ngày." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=156;" vertex="1" parent="Lane_CH"><mxGeometry x="840" y="387" width="10" height="113" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_49" value="Có nguồn (Quy định tiếp nhận của CellphoneS): không trả máy nếu không có phiếu. Cần khảo sát: cách xử lý khi mất phiếu. Mô hình không giả định thay phiếu bằng căn cước, OTP hay số điện thoại." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=161;" vertex="1" parent="Lane_CH"><mxGeometry x="1340" y="375" width="10" height="113" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_50" value="Có nguồn (Trang chủ Điện Thoại Vui): cung cấp thông tin bảo hành khi bàn giao. Cần khảo sát: nhân viên cửa hàng có kiểm tra máy cùng khách không." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1320" y="18" width="10" height="113" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_51" value="Cần khảo sát: cách xử lý khi khách không nhận máy vì còn lỗi. Chưa coi là đã bàn giao." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=156;" vertex="1" parent="Lane_CH"><mxGeometry x="1850" y="375" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_52" value="Cần khảo sát: nơi thu phí và cách thu." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=116;" vertex="1" parent="Lane_CH"><mxGeometry x="2200" y="86" width="10" height="41" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_53" value="Có nguồn (Chính sách bảo hành CellphoneS): khách trả lại máy đã mượn sau khi nhận lại máy của mình. Cần khảo sát: cách ghi nhận." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="2710" y="28" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_54" value="Cần khảo sát: thao tác đóng hồ sơ, lưu hồ sơ điện tử, ghi nhận thời gian xử lý." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="Lane_CH"><mxGeometry x="3045" y="57" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_55" value="Không đồng nhất &quot;đã bàn giao&quot; với &quot;đã sửa chữa thành công&quot;." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="3030" y="268" width="10" height="56" as="geometry"></mxGeometry></mxCell>
