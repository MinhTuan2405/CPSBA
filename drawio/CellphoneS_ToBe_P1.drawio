        <mxCell id="E_thang" value="Khách đến thẳng nơi sửa theo lịch hẹn" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="2842" y="172" width="36" height="36" as="geometry"><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="E_ok" value="Khách đồng ý giao máy" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="2842" y="292" width="36" height="36" as="geometry"><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="E_ve" value="Khách mang máy về, hồ sơ được lưu" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="2842" y="412" width="36" height="36" as="geometry"><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="D_bang" value="Bảng quy tắc phân tuyến" style="shape=mxgraph.bpmn.data2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;size=15;html=1;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="1822" y="190" width="36" height="50" as="geometry"><mxPoint x="57.5" y="-46" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Note_39" value="Khách có thể khai báo lỗi, số IMEI và đặt lịch trước khi đến, qua website, ứng dụng hoặc tổng đài. Tại quầy chỉ cần xác nhận lại." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="450" y="52" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_40" value="Mốc thời gian được lưu: lúc khách đến cửa hàng, lúc khách được tiếp, lúc có hướng xử lý." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="85" y="386" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_41" value="Hướng dẫn sao lưu được đưa lên đầu. Khách chuẩn bị máy trong lúc nhân viên tra cứu và tư vấn." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="770" y="378" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_42" value="Cần khảo sát: công cụ tra cứu hiện tại đã hiện đủ nhóm sản phẩm, quyền lợi và nơi bảo hành chưa." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="940" y="378" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_43" value="Thứ tự tra cứu thay thế: số điện thoại mua hàng, hóa đơn, số Seri trên máy. Vẫn không ra thì người được chỉ định quyết định." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="1300" y="52" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_44" value="Phát hiện sớm dấu hiệu có thể khiến máy không được bảo hành." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1620" y="378" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_45" value="Nơi xử lý cụ thể được chọn ngay tại quầy. Không có nơi phù hợp thì khách biết khi còn giữ máy." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1790" y="378" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_46" value="Cần doanh nghiệp quyết định: ai kết luận lỗi thuộc nhà sản xuất tại cửa hàng; mốc 30 ngày tính đến ngày khách báo lỗi." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1970" y="163" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_47" value="Khách chọn mang máy thẳng đến nơi sửa: bỏ được hai lần giao nhận giữa cửa hàng và nơi sửa." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="2660" y="66" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_48" value="Mức chi phí được ghi vào phiếu. Trong mức này thì bộ phận sửa chữa sửa luôn, không phải chờ khách trả lời." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="2920" y="262" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_49" value="Khách quay lại không phải làm lại từ đầu." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="2640" y="498" width="10" height="41" as="geometry"></mxGeometry></mxCell>
