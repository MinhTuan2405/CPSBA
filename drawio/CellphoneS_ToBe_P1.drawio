        <mxCell id="Note_1" value="SƠ ĐỒ CHI TIẾT 1 (TO-BE): Tiếp nhận yêu cầu, phân tuyến và thỏa thuận tại quầy&lt;br&gt;Mô hình To-Be đề xuất, dựng từ các điểm nghẽn tiềm ẩn của mô hình As-Is. Các điểm nghẽn chưa được đo, nên mỗi thay đổi cần được kiểm chứng trước khi áp dụng. Đây không phải quy trình chính thức của CellphoneS." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=626;" vertex="1" parent="1"><mxGeometry x="160" y="30" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_2" value="Chú giải" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=66;" vertex="1" parent="1"><mxGeometry x="840" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_3" value="Ô nền xanh lá: bước mới" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=166;" vertex="1" parent="1"><mxGeometry x="940" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_4" value="Ô nền vàng: bước As-Is được thay đổi" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=236;" vertex="1" parent="1"><mxGeometry x="1140" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_5" value="Ghi chú đỏ: nội dung thay đổi so với As-Is" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=266;" vertex="1" parent="1"><mxGeometry x="1410" y="30" width="10" height="27" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_6" value="Ghi chú xanh ngọc: cần doanh nghiệp quyết định" style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=296;" vertex="1" parent="1"><mxGeometry x="940" y="66" width="10" height="27" as="geometry"></mxGeometry></mxCell>
