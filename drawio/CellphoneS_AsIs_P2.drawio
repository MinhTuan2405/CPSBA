        <mxCell id="D_phieu" value="Phiếu tiếp nhận" style="shape=mxgraph.bpmn.data2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;size=15;html=1;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="1142" y="250" width="36" height="50" as="geometry"><mxPoint x="63.5" y="-39" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Note_25" value="Đo thời gian 2: từ khi khách đồng ý giao máy đến khi có phiếu tiếp nhận." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="90" y="74" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_26" value="Có nguồn (Quy định tiếp nhận của CellphoneS): khách thoát tài khoản cá nhân, tự sao lưu dữ liệu trước khi bàn giao; CellphoneS không chịu trách nhiệm về dữ liệu." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="250" y="258" width="10" height="113" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_27" value="Cần khảo sát: khi khách chưa chuẩn bị xong, khách hoàn tất tại quầy hay quay lại sau. Có thể là điểm phát sinh thời gian chờ." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="420" y="268" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_28" value="Cần khảo sát: thời điểm được ghi nhận là đã nhận máy." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=126;" vertex="1" parent="Lane_CH"><mxGeometry x="795" y="298" width="10" height="56" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_29" value="Cần khảo sát: các trường được ghi khi nhận máy; số lần phải bổ sung thông tin. Tham khảo, có nguồn (Hướng dẫn của CareS): họ tên, số điện thoại, email, mô tả lỗi." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="940" y="258" width="10" height="113" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_30" value="Có nguồn (Quy định tiếp nhận của CellphoneS): phải có phiếu mới lấy được máy; phiếu có giá trị 60 ngày." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="990" y="38" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_31" value="Nhóm nghiên cứu: lập phiếu cho mọi thiết bị, kể cả lỗi sửa nhanh. Cần khảo sát: phần mềm lập phiếu, các trường trên phiếu." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=186;" vertex="1" parent="Lane_CH"><mxGeometry x="1130" y="324" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_32" value="Có nguồn (Chính sách bảo hành CellphoneS): khách được hỗ trợ miễn phí một điện thoại khác trong thời gian đợi. Cần khảo sát: điều kiện, thời điểm giao, cách ghi nhận." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=196;" vertex="1" parent="Lane_CH"><mxGeometry x="1515" y="38" width="10" height="84" as="geometry"></mxGeometry></mxCell>
