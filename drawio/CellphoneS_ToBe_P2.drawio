        <mxCell id="T2" value="Nhận thiết bị, chụp ảnh tình trạng bên ngoài" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;" vertex="1" parent="Lane_CH"><mxGeometry x="1260" y="270" width="140" height="80" as="geometry"></mxGeometry></mxCell>
        <mxCell id="T3" value="Hoàn tất mẫu tiếp nhận, xác nhận số điện thoại và kênh liên lạc" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;" vertex="1" parent="Lane_CH"><mxGeometry x="1430" y="270" width="140" height="80" as="geometry"></mxGeometry></mxCell>
        <mxCell id="T4" value="Lập phiếu tiếp nhận, gửi mã phiếu cho khách" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;" vertex="1" parent="Lane_CH"><mxGeometry x="1600" y="270" width="140" height="80" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g2" value="Áp dụng hỗ trợ&lt;br&gt;máy dùng tạm?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="1815" y="285" width="50" height="50" as="geometry"><mxPoint x="0" y="-90" as="offset"/></mxGeometry></mxCell>
        <mxCell id="T5" value="Giao máy dùng tạm, ghi nhận vào hồ sơ" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;" vertex="1" parent="Lane_CH"><mxGeometry x="1940" y="270" width="140" height="80" as="geometry"></mxGeometry></mxCell>
