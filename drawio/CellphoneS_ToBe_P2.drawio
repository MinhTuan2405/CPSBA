        <mxCell id="E_ok" value="Đã nhận thiết bị, khách có phiếu tiếp nhận" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="2332" y="292" width="36" height="36" as="geometry"><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="D_phieu" value="Phiếu tiếp nhận" style="shape=mxgraph.bpmn.data2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;size=15;html=1;fontSize=11;whiteSpace=wrap;labelWidth=90;" vertex="1" parent="Lane_CH"><mxGeometry x="1652" y="370" width="36" height="50" as="geometry"><mxPoint x="63.5" y="-39" as="offset"/></mxGeometry></mxCell>
        <mxCell id="Note_31" value="Mốc thời gian được lưu: lúc khách đồng ý giao máy, lúc lập phiếu tiếp nhận." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="80" y="184" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_32" value="Không phải chờ khi khách đã chuẩn bị xong nhờ được nhắc từ đầu ở quầy, hoặc khi lỗi được xử lý nhanh mà không đụng đến dữ liệu trong máy." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="250" y="373" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_33" value="Khu tự sao lưu tách khỏi quầy, có mạng, ổ sạc và tờ hướng dẫn. Quầy được giải phóng cho khách tiếp theo." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="290" y="38" width="10" height="84" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_34" value="Cần doanh nghiệp quyết định: cách làm khi thiết bị không thao tác được, ví dụ hướng dẫn khách gỡ thiết bị khỏi tài khoản từ một thiết bị khác." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="662" y="64" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_35" value="Lần sau khách đi thẳng vào bước nhận máy, không phải tra cứu và tư vấn lại." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1000" y="52" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_36" value="Ảnh lúc nhận máy là căn cứ khi trả máy, tránh tranh cãi về tình trạng bên ngoài." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1280" y="378" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_37" value="Trường bắt buộc do cửa hàng và bộ phận sửa chữa cùng thống nhất, tự điền từ hồ sơ tại quầy. Cần khảo sát: các trường đang được ghi hiện nay." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1450" y="143" width="10" height="99" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_38" value="Lập phiếu là mốc cửa hàng đã nhận máy, điểm bắt đầu của mọi khoảng thời gian cần đo." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="1682" y="172" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_39" value="Phiếu không còn chỉ là một tờ giấy: mã phiếu gắn với số điện thoại của khách, và phiếu ghi ngày hết hạn nhận máy cụ thể." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=201;" vertex="1" parent="Lane_CH"><mxGeometry x="1640" y="444" width="10" height="70" as="geometry"></mxGeometry></mxCell>
        <mxCell id="Note_40" value="Số máy đang cho mượn được theo dõi, để biết còn máy cho khách sau hay không." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fillColor=none;labelPosition=right;align=left;verticalAlign=top;spacingLeft=-5;labelWidth=136;" vertex="1" parent="Lane_CH"><mxGeometry x="2022" y="172" width="10" height="70" as="geometry"></mxGeometry></mxCell>
