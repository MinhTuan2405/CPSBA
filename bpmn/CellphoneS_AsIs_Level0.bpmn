      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Thiếu phiếu, hoặc khách không nhận thiết bị</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Note_47">
      <bpmn:text>Nhóm nghiên cứu: kiểm tra bảo hành ngay tại quầy, trước khi nhận máy. Kết quả chỉ là phân loại sơ bộ.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_47_assoc" sourceRef="Note_47" targetRef="P1" />
    <bpmn:textAnnotation id="Note_48">
      <bpmn:text>Có nguồn (Chính sách bảo hành CellphoneS): đổi mới trong 30 ngày khi lỗi phần cứng từ nhà sản xuất.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_48_assoc" sourceRef="Note_48" targetRef="E_doi" />
    <bpmn:textAnnotation id="Note_49">
      <bpmn:text>Nhóm nghiên cứu: phiếu tiếp nhận được lập cho mọi thiết bị, kể cả lỗi sửa nhanh.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_49_assoc" sourceRef="Note_49" targetRef="P2" />
    <bpmn:textAnnotation id="Note_50">
      <bpmn:text>Nhóm nghiên cứu: cửa hàng tự xử lý lỗi đơn giản như thay miếng dán màn hình, lỗi phần mềm. Cần khảo sát: danh mục lỗi.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_50_assoc" sourceRef="Note_50" targetRef="TQ" />
    <bpmn:textAnnotation id="Note_51">
      <bpmn:text>Có: cửa hàng không xử lý được và khách đồng ý chuyển. Không: đã xử lý xong, hoặc khách không tiếp tục.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_51_assoc" sourceRef="Note_51" targetRef="gq" />
    <bpmn:textAnnotation id="Note_52">
      <bpmn:text>Cần khảo sát: cách chuyển thiết bị, người phụ trách, mốc giao và mốc nhận.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_52_assoc" sourceRef="Note_52" targetRef="P3" />
    <bpmn:textAnnotation id="Note_53">
      <bpmn:text>Cần khảo sát: không có nguồn về quy trình bên trong của hãng; khi hãng từ chối bảo hành thì xử lý thế nào.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_53_assoc" sourceRef="Note_53" targetRef="CHg" />
    <bpmn:textAnnotation id="Note_54">
      <bpmn:text>Có nguồn (Trang chủ Điện Thoại Vui, Hướng dẫn của CareS): kiểm tra, báo giá, sửa sau khi khách đồng ý, kiểm tra lại.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_54_assoc" sourceRef="Note_54" targetRef="P4" />
    <bpmn:textAnnotation id="Note_55">
      <bpmn:text>Có nguồn (Quy định tiếp nhận của CellphoneS): phiếu có giá trị lấy máy trong 60 ngày.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_55_assoc" sourceRef="Note_55" targetRef="E_60" />
  </bpmn:process>
