    <bpmn:messageFlow id="Msg_45" name="Thông báo nhận máy, thiết bị" sourceRef="P5" targetRef="Participant_KH" />
    <bpmn:messageFlow id="Msg_46" name="Phiếu tiếp nhận, phí sửa chữa nếu có" sourceRef="Participant_KH" targetRef="P5" />
    <bpmn:textAnnotation id="Note_1">
      <bpmn:text>SƠ ĐỒ TỔNG QUAN: Tiếp nhận và xử lý yêu cầu bảo hành, sửa chữa thiết bị qua cửa hàng CellphoneS
Mô hình As-Is sơ bộ, dựng từ tài liệu công khai và hiểu biết của nhóm nghiên cứu. Đây không phải quy trình nội bộ chính thức của CellphoneS.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_2">
      <bpmn:text>Chú giải màu ghi chú</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_3">
      <bpmn:text>Xanh lá: có nguồn công khai</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_4">
      <bpmn:text>Cam: cần khảo sát</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_5">
      <bpmn:text>Tím: do nhóm nghiên cứu đưa ra</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_6">
      <bpmn:text>Xanh dương: khoảng thời gian cần đo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_56">
      <bpmn:text>Theo dõi trạng thái xuyên suốt. Có nguồn: khách tra cứu qua trang Điện Thoại Vui và Smember. Cần khảo sát: ai cập nhật, khi nào, ở hệ thống nào; cửa hàng và bộ phận sửa chữa có thấy cùng trạng thái không; khách được báo hay phải tự tra cứu.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
