    <bpmn:messageFlow id="Msg_54" name="Đồng ý hoặc từ chối" sourceRef="Participant_KH" targetRef="P4" />
    <bpmn:messageFlow id="Msg_55" name="Thông báo, lời nhắc, thiết bị" sourceRef="P5" targetRef="Participant_KH" />
    <bpmn:messageFlow id="Msg_56" name="Phiếu hoặc mã phiếu, phí nếu có" sourceRef="Participant_KH" targetRef="P5" />
    <bpmn:textAnnotation id="Note_1">
      <bpmn:text>SƠ ĐỒ TỔNG QUAN (TO-BE): Tiếp nhận và xử lý yêu cầu bảo hành, sửa chữa thiết bị qua cửa hàng CellphoneS
Mô hình To-Be đề xuất, dựng từ các điểm nghẽn tiềm ẩn của mô hình As-Is. Các điểm nghẽn chưa được đo, nên mỗi thay đổi cần được kiểm chứng trước khi áp dụng. Đây không phải quy trình chính thức của CellphoneS.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_2">
      <bpmn:text>Chú giải</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_3">
      <bpmn:text>Ô nền xanh lá: bước mới</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_4">
      <bpmn:text>Ô nền vàng: bước As-Is được thay đổi</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_5">
      <bpmn:text>Ghi chú đỏ: nội dung thay đổi so với As-Is</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_6">
      <bpmn:text>Ghi chú xanh ngọc: cần doanh nghiệp quyết định</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_7">
      <bpmn:text>Ghi chú cam: cần khảo sát trước khi áp dụng</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_8">
      <bpmn:text>Ghi chú xanh dương: mốc thời gian được lưu lại</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_57">
      <bpmn:text>Theo dõi trạng thái xuyên suốt: một mã hồ sơ từ phiếu tiếp nhận đi suốt quy trình ở cả cửa hàng và bộ phận sửa chữa; trạng thái đổi theo chính thao tác nghiệp vụ; khách được báo ở các mốc chính; thời điểm mỗi mốc được lưu lại. Cần khảo sát: hệ thống hiện tại đã làm được phần nào.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
