    <bpmn:messageFlow id="Msg_45" name="Yêu cầu bảo hành, sửa chữa" sourceRef="Participant_KH" targetRef="S" />
    <bpmn:messageFlow id="Msg_46" name="Tư vấn và các lựa chọn" sourceRef="P1" targetRef="Participant_KH" />
    <bpmn:messageFlow id="Msg_47" name="Quyết định của khách" sourceRef="Participant_KH" targetRef="P1" />
    <bpmn:messageFlow id="Msg_48" name="Thiết bị" sourceRef="Participant_KH" targetRef="P2" />
