    <bpmn:messageFlow id="Msg_50" name="Thông báo nơi xử lý đã nhận máy" sourceRef="P3" targetRef="Participant_KH" />
    <bpmn:messageFlow id="Msg_51" name="Thiết bị và hồ sơ yêu cầu" sourceRef="P3" targetRef="Participant_HANG" />
