<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe_P2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="CellphoneS To-Be BPMN generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_ToBe_P2">
    <bpmn:participant id="Participant_KH" name="Khách hàng" />
    <bpmn:participant id="Participant_CPS" name="Hệ thống CellphoneS" processRef="Process_CPS" />
    <bpmn:messageFlow id="Msg_25" name="Lời mời hoàn tất chuẩn bị" sourceRef="T1" targetRef="Participant_KH" />
    <bpmn:messageFlow id="Msg_26" name="Phản hồi của khách" sourceRef="Participant_KH" targetRef="C1" />
    <bpmn:messageFlow id="Msg_27" name="Thiết bị" sourceRef="Participant_KH" targetRef="T2" />
    <bpmn:messageFlow id="Msg_28" name="Phiếu tiếp nhận và mã phiếu" sourceRef="T4" targetRef="Participant_KH" />
    <bpmn:messageFlow id="Msg_29" name="Máy dùng tạm" sourceRef="T5" targetRef="Participant_KH" />
    <bpmn:textAnnotation id="Note_1">
      <bpmn:text>SƠ ĐỒ CHI TIẾT 2 (TO-BE): Nhận thiết bị và lập phiếu tiếp nhận
Mô hình To-Be đề xuất, dựng từ các điểm nghẽn tiềm ẩn của mô hình As-Is. Các điểm nghẽn chưa được đo, nên mỗi thay đổi cần được kiểm chứng trước khi áp dụng. Đây không phải quy trình chính thức của CellphoneS.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_2">
      <bpmn:text>Chú giải</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_3">
      <bpmn:text>Ô nền xanh lá: bước mới</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_4">
      <bpmn:text>Ô nền vàng: bước As-Is được thay đổi</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_5">
      <bpmn:text>Ghi chú đỏ: nội dung thay đổi so với As-Is</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_6">
      <bpmn:text>Ghi chú xanh ngọc: cần doanh nghiệp quyết định</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_7">
      <bpmn:text>Ghi chú cam: cần khảo sát trước khi áp dụng</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_8">
      <bpmn:text>Ghi chú xanh dương: mốc thời gian được lưu lại</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_CPS" name="Hệ thống CellphoneS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_CPS">
      <bpmn:lane id="Lane_CH" name="Cửa hàng CellphoneS">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_chua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Khách đồng ý giao máy">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g0" name="Cần chờ khách&#10;chuẩn bị thiết bị?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T1" name="Mời khách hoàn tất tại khu tự sao lưu">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="C1" name="Nhận phản hồi của khách">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Khách giao&#10;thiết bị?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T0" name="Lưu hồ sơ để khách quay lại không phải làm lại">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_chua" name="Khách chưa giao máy, hồ sơ được lưu">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="m1">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="Nhận thiết bị, chụp ảnh tình trạng bên ngoài">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Hoàn tất mẫu tiếp nhận, xác nhận số điện thoại và kênh liên lạc">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="Lập phiếu tiếp nhận, gửi mã phiếu cho khách">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_30">
        <bpmn:targetRef>D_phieu</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Áp dụng hỗ trợ&#10;máy dùng tạm?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Giao máy dùng tạm, ghi nhận vào hồ sơ">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m2">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_ok" name="Đã nhận thiết bị, khách có phiếu tiếp nhận">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="D_phieu_obj" />
    <bpmn:dataObjectReference id="D_phieu" name="Phiếu tiếp nhận" dataObjectRef="D_phieu_obj" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="S" targetRef="g0" />
    <bpmn:sequenceFlow id="Flow_10" name="Có" sourceRef="g0" targetRef="T1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Không" sourceRef="g0" targetRef="m1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T1" targetRef="C1" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="C1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_14" name="Chưa:&#10;khách ra về" sourceRef="g1" targetRef="T0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chưa:
khách ra về</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="Có" sourceRef="g1" targetRef="m1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T0" targetRef="E_chua" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="m1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="T4" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_21" name="Có" sourceRef="g2" targetRef="T5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" name="Không" sourceRef="g2" targetRef="m2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="T5" targetRef="m2" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="m2" targetRef="E_ok" />
    <bpmn:textAnnotation id="Note_31">
      <bpmn:text>Mốc thời gian được lưu: lúc khách đồng ý giao máy, lúc lập phiếu tiếp nhận.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_31_assoc" sourceRef="Note_31" targetRef="S" />
    <bpmn:textAnnotation id="Note_32">
      <bpmn:text>Không phải chờ khi khách đã chuẩn bị xong nhờ được nhắc từ đầu ở quầy, hoặc khi lỗi được xử lý nhanh mà không đụng đến dữ liệu trong máy.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_32_assoc" sourceRef="Note_32" targetRef="g0" />
    <bpmn:textAnnotation id="Note_33">
      <bpmn:text>Khu tự sao lưu tách khỏi quầy, có mạng, ổ sạc và tờ hướng dẫn. Quầy được giải phóng cho khách tiếp theo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_33_assoc" sourceRef="Note_33" targetRef="T1" />
    <bpmn:textAnnotation id="Note_34">
      <bpmn:text>Cần doanh nghiệp quyết định: cách làm khi thiết bị không thao tác được, ví dụ hướng dẫn khách gỡ thiết bị khỏi tài khoản từ một thiết bị khác.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_34_assoc" sourceRef="Note_34" targetRef="C1" />
    <bpmn:textAnnotation id="Note_35">
      <bpmn:text>Lần sau khách đi thẳng vào bước nhận máy, không phải tra cứu và tư vấn lại.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_35_assoc" sourceRef="Note_35" targetRef="T0" />
    <bpmn:textAnnotation id="Note_36">
      <bpmn:text>Ảnh lúc nhận máy là căn cứ khi trả máy, tránh tranh cãi về tình trạng bên ngoài.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_36_assoc" sourceRef="Note_36" targetRef="T2" />
    <bpmn:textAnnotation id="Note_37">
      <bpmn:text>Trường bắt buộc do cửa hàng và bộ phận sửa chữa cùng thống nhất, tự điền từ hồ sơ tại quầy. Cần khảo sát: các trường đang được ghi hiện nay.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_37_assoc" sourceRef="Note_37" targetRef="T3" />
    <bpmn:textAnnotation id="Note_38">
      <bpmn:text>Lập phiếu là mốc cửa hàng đã nhận máy, điểm bắt đầu của mọi khoảng thời gian cần đo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_38_assoc" sourceRef="Note_38" targetRef="T4" />
    <bpmn:textAnnotation id="Note_39">
      <bpmn:text>Phiếu không còn chỉ là một tờ giấy: mã phiếu gắn với số điện thoại của khách, và phiếu ghi ngày hết hạn nhận máy cụ thể.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_39_assoc" sourceRef="Note_39" targetRef="D_phieu" />
    <bpmn:textAnnotation id="Note_40">
      <bpmn:text>Số máy đang cho mượn được theo dõi, để biết còn máy cho khách sau hay không.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_40_assoc" sourceRef="Note_40" targetRef="T5" />
  </bpmn:process>
