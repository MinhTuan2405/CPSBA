    <bpmn:sequenceFlow id="Flow_36" sourceRef="mE" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="T7" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="T9" targetRef="E" />
    <bpmn:textAnnotation id="Note_48">
      <bpmn:text>Lỗi đơn giản và lỗi phức tạp đi hai hàng chờ riêng. Thứ tự tính từ lúc khách giao máy tại cửa hàng.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_48_assoc" sourceRef="Note_48" targetRef="T0" />
    <bpmn:textAnnotation id="Note_49">
      <bpmn:text>Mốc thời gian được lưu: lúc nhận máy, lúc chẩn đoán xong, lúc gửi báo giá, lúc khách trả lời, lúc sửa xong.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_49_assoc" sourceRef="Note_49" targetRef="S" />
    <bpmn:textAnnotation id="Note_50">
      <bpmn:text>Linh kiện được kiểm tra ngay lúc này, nên thời gian chờ linh kiện có sẵn trong báo giá.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_50_assoc" sourceRef="Note_50" targetRef="T3" />
    <bpmn:textAnnotation id="Note_51">
      <bpmn:text>Không cần hỏi khi máy được bảo hành, hoặc khi chi phí nằm trong mức khách đã chấp nhận tại quầy. Chỉ hỏi lại khi chi phí vượt mức đó.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_51_assoc" sourceRef="Note_51" targetRef="g1" />
    <bpmn:textAnnotation id="Note_52">
      <bpmn:text>Báo giá gửi qua kênh khách bấm đồng ý hoặc từ chối được ngay; câu trả lời được lưu làm xác nhận. Có thể giữ chỗ linh kiện trong lúc chờ.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_52_assoc" sourceRef="Note_52" targetRef="T4" />
    <bpmn:textAnnotation id="Note_53">
      <bpmn:text>Cần doanh nghiệp quyết định: hạn phản hồi và số lần nhắc. Hết hạn thì trả máy chưa sửa.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_53_assoc" sourceRef="Note_53" targetRef="TMd" />
    <bpmn:textAnnotation id="Note_54">
      <bpmn:text>Khách được báo cả khi không phát sinh chi phí: máy được sửa theo phương án nào, dự kiến xong ngày nào.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_54_assoc" sourceRef="Note_54" targetRef="Tb" />
    <bpmn:textAnnotation id="Note_55">
      <bpmn:text>Cần khảo sát: có phải chờ linh kiện không, chờ bao lâu. Máy còn dùng được thì khách có thể nhận lại trong lúc chờ.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_55_assoc" sourceRef="Note_55" targetRef="C2" />
    <bpmn:textAnnotation id="Note_56">
      <bpmn:text>Danh sách kiểm gồm lỗi ban đầu theo mô tả trên phiếu và các tính năng cơ bản.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_56_assoc" sourceRef="Note_56" targetRef="T6" />
    <bpmn:textAnnotation id="Note_57">
      <bpmn:text>Cần doanh nghiệp quyết định: số lần sửa lại tối đa. Hết số lần thì người có kinh nghiệm hơn xem xét; nếu đổi chi phí thì hỏi lại khách.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_57_assoc" sourceRef="Note_57" targetRef="Tl" />
    <bpmn:textAnnotation id="Note_58">
      <bpmn:text>Thông tin đi trước thiết bị: cửa hàng và khách biết ngay khi sửa xong, kèm ngày dự kiến máy có tại cửa hàng.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_58_assoc" sourceRef="Note_58" targetRef="T7" />
    <bpmn:textAnnotation id="Note_59">
      <bpmn:text>Chuyến mang máy mới đến cũng mang máy đã xong về. Giao và nhận đều được xác nhận.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_59_assoc" sourceRef="Note_59" targetRef="T9" />
  </bpmn:process>
