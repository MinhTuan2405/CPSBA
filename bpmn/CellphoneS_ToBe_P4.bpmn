      <bpmn:outgoing>Flow_37</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_46">
        <bpmn:targetRef>D_kqxl</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T9" name="Chuyển thiết bị về cửa hàng theo chuyến cố định, xác nhận đã giao">
