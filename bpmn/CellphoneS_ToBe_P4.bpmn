      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E" name="Kết quả và thiết bị đã về cửa hàng">
      <bpmn:incoming>Flow_38</bpmn:incoming>
    </bpmn:endEvent>
