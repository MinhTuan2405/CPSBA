<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="CellphoneS As-Is BPMN generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P2">
    <bpmn:participant id="Participant_KH" name="Khách hàng" />
    <bpmn:participant id="Participant_CPS" name="Hệ thống CellphoneS" processRef="Process_CPS" />
    <bpmn:messageFlow id="Msg_19" name="Hướng dẫn chuẩn bị thiết bị" sourceRef="T1" targetRef="Participant_KH" />
    <bpmn:messageFlow id="Msg_20" name="Phản hồi của khách" sourceRef="Participant_KH" targetRef="C1" />
    <bpmn:messageFlow id="Msg_21" name="Thiết bị" sourceRef="Participant_KH" targetRef="T2" />
    <bpmn:messageFlow id="Msg_22" name="Phiếu tiếp nhận" sourceRef="T4" targetRef="Participant_KH" />
    <bpmn:messageFlow id="Msg_23" name="Máy dùng tạm" sourceRef="T5" targetRef="Participant_KH" />
    <bpmn:textAnnotation id="Note_1">
      <bpmn:text>SƠ ĐỒ CHI TIẾT 2: Nhận thiết bị và lập phiếu tiếp nhận
Mô hình As-Is sơ bộ, dựng từ tài liệu công khai và hiểu biết của nhóm nghiên cứu. Đây không phải quy trình nội bộ chính thức của CellphoneS.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_2">
      <bpmn:text>Chú giải màu ghi chú</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_3">
      <bpmn:text>Xanh lá: có nguồn công khai</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_4">
      <bpmn:text>Cam: cần khảo sát</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_5">
      <bpmn:text>Tím: do nhóm nghiên cứu đưa ra</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_6">
      <bpmn:text>Xanh dương: khoảng thời gian cần đo</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_CPS" name="Hệ thống CellphoneS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_CPS">
      <bpmn:lane id="Lane_CH" name="Cửa hàng CellphoneS">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_chua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Khách đồng ý giao máy">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Hướng dẫn khách thoát tài khoản và sao lưu dữ liệu">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="C1" name="Nhận phản hồi của khách">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Khách giao&#10;thiết bị?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_chua" name="Khách chưa giao máy">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T2" name="Nhận thiết bị từ khách">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Ghi nhận thông tin tiếp nhận">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="Lập phiếu tiếp nhận và giao cho khách">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_24">
        <bpmn:targetRef>D_phieu</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Áp dụng hỗ trợ&#10;máy dùng tạm?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Giao máy dùng tạm cho khách">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m2">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_ok" name="Đã nhận thiết bị, khách có phiếu tiếp nhận">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="D_phieu_obj" />
    <bpmn:dataObjectReference id="D_phieu" name="Phiếu tiếp nhận" dataObjectRef="D_phieu_obj" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T1" targetRef="C1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="C1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_10" name="Chưa:&#10;khách ra về" sourceRef="g1" targetRef="E_chua">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chưa:
khách ra về</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Có" sourceRef="g1" targetRef="T2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T4" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_15" name="Có" sourceRef="g2" targetRef="T5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" name="Không" sourceRef="g2" targetRef="m2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T5" targetRef="m2" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="m2" targetRef="E_ok" />
    <bpmn:textAnnotation id="Note_25">
      <bpmn:text>Đo thời gian 2: từ khi khách đồng ý giao máy đến khi có phiếu tiếp nhận.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_25_assoc" sourceRef="Note_25" targetRef="S" />
    <bpmn:textAnnotation id="Note_26">
      <bpmn:text>Có nguồn (Quy định tiếp nhận của CellphoneS): khách thoát tài khoản cá nhân, tự sao lưu dữ liệu trước khi bàn giao; CellphoneS không chịu trách nhiệm về dữ liệu.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_26_assoc" sourceRef="Note_26" targetRef="T1" />
    <bpmn:textAnnotation id="Note_27">
      <bpmn:text>Cần khảo sát: khi khách chưa chuẩn bị xong, khách hoàn tất tại quầy hay quay lại sau. Có thể là điểm phát sinh thời gian chờ.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_27_assoc" sourceRef="Note_27" targetRef="C1" />
    <bpmn:textAnnotation id="Note_28">
      <bpmn:text>Cần khảo sát: thời điểm được ghi nhận là đã nhận máy.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_28_assoc" sourceRef="Note_28" targetRef="T2" />
    <bpmn:textAnnotation id="Note_29">
      <bpmn:text>Cần khảo sát: các trường được ghi khi nhận máy; số lần phải bổ sung thông tin. Tham khảo, có nguồn (Hướng dẫn của CareS): họ tên, số điện thoại, email, mô tả lỗi.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_29_assoc" sourceRef="Note_29" targetRef="T3" />
    <bpmn:textAnnotation id="Note_30">
      <bpmn:text>Có nguồn (Quy định tiếp nhận của CellphoneS): phải có phiếu mới lấy được máy; phiếu có giá trị 60 ngày.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_30_assoc" sourceRef="Note_30" targetRef="T4" />
    <bpmn:textAnnotation id="Note_31">
      <bpmn:text>Nhóm nghiên cứu: lập phiếu cho mọi thiết bị, kể cả lỗi sửa nhanh. Cần khảo sát: phần mềm lập phiếu, các trường trên phiếu.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_31_assoc" sourceRef="Note_31" targetRef="D_phieu" />
    <bpmn:textAnnotation id="Note_32">
      <bpmn:text>Có nguồn (Chính sách bảo hành CellphoneS): khách được hỗ trợ miễn phí một điện thoại khác trong thời gian đợi. Cần khảo sát: điều kiện, thời điểm giao, cách ghi nhận.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_32_assoc" sourceRef="Note_32" targetRef="T5" />
  </bpmn:process>
