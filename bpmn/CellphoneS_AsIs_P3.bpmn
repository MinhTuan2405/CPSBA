      </bpmn:lane>
      <bpmn:lane id="Lane_SC" name="Bộ phận sửa chữa (Điện Thoại Vui; CareS với thiết bị Apple)">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Thiết bị đã được nhận giữ">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="mA">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T1" name="Xác định nơi xử lý cụ thể">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Có nơi xử lý&#10;phù hợp?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E0" name="Không có nơi xử lý phù hợp">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T2" name="Chuẩn bị hồ sơ và thông tin yêu cầu">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Chuyển&#10;đến đâu?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3h" name="Gửi thiết bị và hồ sơ đến hãng">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3s" name="Bàn giao thiết bị và hồ sơ cho bộ phận sửa chữa">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="C1" name="Nhận phản hồi tiếp nhận của hãng">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T4" name="Tiếp nhận thiết bị từ cửa hàng">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="mC">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Phản hồi của&#10;nơi xử lý?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Bổ sung thông tin theo yêu cầu">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="mD">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Nơi xử lý đã nhận thiết bị">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="S" targetRef="mA" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="mA" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_10" name="Không" sourceRef="g1" targetRef="E0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Có" sourceRef="g1" targetRef="T2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T2" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_13" name="Hãng" sourceRef="g2" targetRef="T3h">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Hãng</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="Bộ phận sửa chữa trong hệ thống" sourceRef="g2" targetRef="T3s">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Bộ phận sửa chữa trong hệ thống</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T3h" targetRef="C1" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="C1" targetRef="mC" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T3s" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T4" targetRef="mC" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="mC" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_20" name="Đã nhận thiết bị" sourceRef="g3" targetRef="mD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Đã nhận thiết bị</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" name="Yêu cầu bổ sung thông tin" sourceRef="g3" targetRef="T5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yêu cầu bổ sung thông tin</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="T5" targetRef="mD" />
    <bpmn:sequenceFlow id="Flow_23" name="Không tiếp nhận theo tuyến này" sourceRef="g3" targetRef="mA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không tiếp nhận theo tuyến này</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="mD" targetRef="E1" />
    <bpmn:textAnnotation id="Note_27">
      <bpmn:text>Đo thời gian 3: từ khi có phiếu tiếp nhận đến khi cửa hàng giao thiết bị đi (mốc A).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_27_assoc" sourceRef="Note_27" targetRef="S" />
    <bpmn:textAnnotation id="Note_28">
      <bpmn:text>Có nguồn (Chính sách bảo hành CellphoneS): nơi bảo hành theo nhóm sản phẩm. Cần khảo sát: ai có quyền chỉ định nơi xử lý.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_28_assoc" sourceRef="Note_28" targetRef="T1" />
    <bpmn:textAnnotation id="Note_29">
      <bpmn:text>Thiết bị được trả lại cho khách ở trạng thái chưa xử lý (sơ đồ chi tiết 5).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_29_assoc" sourceRef="Note_29" targetRef="E0" />
    <bpmn:textAnnotation id="Note_30">
      <bpmn:text>Cần khảo sát: hồ sơ gồm những gì; có bước xác nhận hồ sơ đủ thông tin không.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_30_assoc" sourceRef="Note_30" targetRef="T2" />
    <bpmn:textAnnotation id="Note_31">
      <bpmn:text>Mốc A: cửa hàng đã giao thiết bị. Có nguồn (Chính sách bảo hành CellphoneS): cửa hàng tiếp nhận để gửi máy bảo hành chính hãng. Cần khảo sát: cách gửi, người phụ trách.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_31_assoc" sourceRef="Note_31" targetRef="T3h" />
    <bpmn:textAnnotation id="Note_32">
      <bpmn:text>Mốc A: cửa hàng đã giao thiết bị. Cần khảo sát: bộ phận sửa chữa ở cùng địa điểm hay phải vận chuyển; hình thức xác nhận bàn giao.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_32_assoc" sourceRef="Note_32" targetRef="T3s" />
    <bpmn:textAnnotation id="Note_33">
      <bpmn:text>Mốc B: nơi xử lý đã nhận thiết bị. Cần khảo sát: hai mốc A và B có được ghi nhận trên hệ thống không.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_33_assoc" sourceRef="Note_33" targetRef="C1" />
    <bpmn:textAnnotation id="Note_34">
      <bpmn:text>Đo thời gian 4: từ mốc A đến mốc B.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_34_assoc" sourceRef="Note_34" targetRef="T4" />
    <bpmn:textAnnotation id="Note_35">
      <bpmn:text>Cần khảo sát: toàn bộ các tình huống ngoại lệ ở bước này. Mô hình giả định sau khi bổ sung thông tin thì nơi xử lý tiếp nhận.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_35_assoc" sourceRef="Note_35" targetRef="T5" />
  </bpmn:process>
