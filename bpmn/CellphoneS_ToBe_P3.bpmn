      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="Gửi hồ sơ trước cho bộ phận sửa chữa">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Xem hồ sơ và trả lời cửa hàng">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g3" name="Trả lời&#10;về hồ sơ?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Bổ sung thông tin theo yêu cầu">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="mS">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T6" name="Giao thiết bị theo chuyến cố định, xác nhận đã giao">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T8" name="Xác nhận đã nhận thiết bị">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="mF">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T9" name="Ghi mốc nơi xử lý đã nhận, báo cho khách">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Nơi xử lý đã nhận thiết bị">
      <bpmn:incoming>Flow_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="S" targetRef="mA" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="mA" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_12" name="Không" sourceRef="g1" targetRef="E0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="Có" sourceRef="g1" targetRef="g2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="Trung tâm bảo&#10;hành của hãng" sourceRef="g2" targetRef="T2h">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Trung tâm bảo
hành của hãng</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="Bộ phận sửa chữa&#10;trong hệ thống" sourceRef="g2" targetRef="T2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Bộ phận sửa chữa
trong hệ thống</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T2h" targetRef="C1" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="C1" targetRef="gH" />
    <bpmn:sequenceFlow id="Flow_18" name="Có" sourceRef="gH" targetRef="mF">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" name="Không" sourceRef="gH" targetRef="mA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="T3" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_22" name="Cần bổ sung&#10;thông tin" sourceRef="g3" targetRef="T5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Cần bổ sung
thông tin</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" name="Tiếp nhận" sourceRef="g3" targetRef="mS">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tiếp nhận</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" name="Không tiếp nhận" sourceRef="g3" targetRef="mA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không tiếp nhận</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="T5" targetRef="mS" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="mS" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="T6" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="T8" targetRef="mF" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="mF" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="T9" targetRef="E1" />
    <bpmn:textAnnotation id="Note_34">
      <bpmn:text>Nơi xử lý đã được chọn tại quầy. Ở đây chỉ xác nhận lại và kiểm hồ sơ theo danh sách kiểm trước khi gửi.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_34_assoc" sourceRef="Note_34" targetRef="T1" />
    <bpmn:textAnnotation id="Note_35">
      <bpmn:text>Thiết bị còn ở cửa hàng, nên được trả lại cho khách ngay (sơ đồ chi tiết 5).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_35_assoc" sourceRef="Note_35" targetRef="E0" />
    <bpmn:textAnnotation id="Note_36">
      <bpmn:text>Danh sách kiểm hồ sơ riêng cho từng hãng. Cần khảo sát: cách gửi, người phụ trách, hồ sơ mỗi hãng yêu cầu.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_36_assoc" sourceRef="Note_36" targetRef="T2h" />
    <bpmn:textAnnotation id="Note_37">
      <bpmn:text>Mã tiếp nhận của hãng được lưu vào hồ sơ. Cần khảo sát: hãng có cấp mã hay không.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_37_assoc" sourceRef="Note_37" targetRef="C1" />
    <bpmn:textAnnotation id="Note_38">
      <bpmn:text>Hồ sơ đi trước thiết bị: bộ phận sửa chữa trả lời khi thiết bị còn ở cửa hàng, nên máy không phải đi rồi quay về.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_38_assoc" sourceRef="Note_38" targetRef="T2" />
    <bpmn:textAnnotation id="Note_39">
      <bpmn:text>Cần khảo sát: bộ phận sửa chữa có ở cùng địa điểm với cửa hàng không. Nếu có thì bàn giao ngay sau khi lập phiếu, không cần gom chuyến.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_39_assoc" sourceRef="Note_39" targetRef="T3" />
    <bpmn:textAnnotation id="Note_40">
      <bpmn:text>Chuyển theo lịch cố định, mỗi ca có một người phụ trách giao nhận. Cần doanh nghiệp quyết định: số chuyến mỗi ngày và giờ chốt.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_40_assoc" sourceRef="Note_40" targetRef="T6" />
    <bpmn:textAnnotation id="Note_41">
      <bpmn:text>Hai mốc thời gian được lưu: cửa hàng đã giao, nơi xử lý đã nhận. Máy đã giao mà chưa có xác nhận nhận được rà soát mỗi ngày.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_41_assoc" sourceRef="Note_41" targetRef="T8" />
    <bpmn:textAnnotation id="Note_42">
      <bpmn:text>Khách được báo ngay khi nơi xử lý đã nhận máy, không phải tự hỏi.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_42_assoc" sourceRef="Note_42" targetRef="T9" />
  </bpmn:process>
