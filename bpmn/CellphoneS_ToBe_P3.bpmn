<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe_P3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="CellphoneS To-Be BPMN generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_ToBe_P3">
    <bpmn:participant id="Participant_HANG" name="Trung tâm bảo hành của hãng" />
    <bpmn:participant id="Participant_CPS" name="Hệ thống CellphoneS" processRef="Process_CPS" />
    <bpmn:participant id="Participant_KH" name="Khách hàng" />
    <bpmn:messageFlow id="Msg_31" name="Thiết bị và hồ sơ yêu cầu" sourceRef="T2h" targetRef="Participant_HANG" />
    <bpmn:messageFlow id="Msg_32" name="Phản hồi tiếp nhận, mã tiếp nhận" sourceRef="Participant_HANG" targetRef="C1" />
    <bpmn:messageFlow id="Msg_33" name="Thông báo: nơi xử lý đã nhận máy" sourceRef="T9" targetRef="Participant_KH" />
    <bpmn:textAnnotation id="Note_1">
      <bpmn:text>SƠ ĐỒ CHI TIẾT 3 (TO-BE): Chuyển thiết bị đến nơi xử lý
Mô hình To-Be đề xuất, dựng từ các điểm nghẽn tiềm ẩn của mô hình As-Is. Các điểm nghẽn chưa được đo, nên mỗi thay đổi cần được kiểm chứng trước khi áp dụng. Đây không phải quy trình chính thức của CellphoneS.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_2">
      <bpmn:text>Chú giải</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_3">
      <bpmn:text>Ô nền xanh lá: bước mới</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_4">
      <bpmn:text>Ô nền vàng: bước As-Is được thay đổi</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_5">
      <bpmn:text>Ghi chú đỏ: nội dung thay đổi so với As-Is</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_6">
      <bpmn:text>Ghi chú xanh ngọc: cần doanh nghiệp quyết định</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_7">
      <bpmn:text>Ghi chú cam: cần khảo sát trước khi áp dụng</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_8">
      <bpmn:text>Ghi chú xanh dương: mốc thời gian được lưu lại</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_CPS" name="Hệ thống CellphoneS" isExecutable="false">
