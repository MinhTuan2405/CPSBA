    <bpmn:textAnnotation id="Note_42">
      <bpmn:text>Đo thời gian 9: từ khi sửa xong đến khi thiết bị sẵn sàng trả tại cửa hàng.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_42_assoc" sourceRef="Note_42" targetRef="T1" />
    <bpmn:textAnnotation id="Note_43">
      <bpmn:text>Cần khảo sát: cách cửa hàng nhận lại thiết bị từ nơi xử lý.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_43_assoc" sourceRef="Note_43" targetRef="T1" />
    <bpmn:textAnnotation id="Note_44">
      <bpmn:text>Cần khảo sát: cách đối chiếu kết quả và xác định thiết bị sẵn sàng trả.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_44_assoc" sourceRef="Note_44" targetRef="T2" />
    <bpmn:textAnnotation id="Note_45">
      <bpmn:text>Đo thời gian 10: từ khi thiết bị sẵn sàng đến khi khách được báo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_45_assoc" sourceRef="Note_45" targetRef="T3" />
    <bpmn:textAnnotation id="Note_46">
      <bpmn:text>Cần khảo sát: ai báo, kênh nào, khi nào coi là đã báo. Khách đang chờ tại cửa hàng (xử lý nhanh) thì được trả máy ngay.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_46_assoc" sourceRef="Note_46" targetRef="T3" />
    <bpmn:textAnnotation id="Note_47">
      <bpmn:text>Đo thời gian 11: từ khi khách được báo đến khi khách nhận máy.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_47_assoc" sourceRef="Note_47" targetRef="C1" />
    <bpmn:textAnnotation id="Note_48">
      <bpmn:text>Có nguồn (Quy định tiếp nhận của CellphoneS): phiếu có giá trị lấy máy trong 60 ngày; sau đó tháo gỡ linh kiện để tái chế. Cần khảo sát: mốc bắt đầu tính 60 ngày.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_48_assoc" sourceRef="Note_48" targetRef="TM" />
    <bpmn:textAnnotation id="Note_49">
      <bpmn:text>Có nguồn (Quy định tiếp nhận của CellphoneS): không trả máy nếu không có phiếu. Cần khảo sát: cách xử lý khi mất phiếu. Mô hình không giả định thay phiếu bằng căn cước, OTP hay số điện thoại.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_49_assoc" sourceRef="Note_49" targetRef="E4a" />
    <bpmn:textAnnotation id="Note_50">
      <bpmn:text>Có nguồn (Trang chủ Điện Thoại Vui): cung cấp thông tin bảo hành khi bàn giao. Cần khảo sát: nhân viên cửa hàng có kiểm tra máy cùng khách không.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_50_assoc" sourceRef="Note_50" targetRef="T6" />
    <bpmn:textAnnotation id="Note_51">
      <bpmn:text>Cần khảo sát: cách xử lý khi khách không nhận máy vì còn lỗi. Chưa coi là đã bàn giao.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_51_assoc" sourceRef="Note_51" targetRef="E4b" />
    <bpmn:textAnnotation id="Note_52">
      <bpmn:text>Cần khảo sát: nơi thu phí và cách thu.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_52_assoc" sourceRef="Note_52" targetRef="T7" />
    <bpmn:textAnnotation id="Note_53">
      <bpmn:text>Có nguồn (Chính sách bảo hành CellphoneS): khách trả lại máy đã mượn sau khi nhận lại máy của mình. Cần khảo sát: cách ghi nhận.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_53_assoc" sourceRef="Note_53" targetRef="T8" />
    <bpmn:textAnnotation id="Note_54">
      <bpmn:text>Cần khảo sát: thao tác đóng hồ sơ, lưu hồ sơ điện tử, ghi nhận thời gian xử lý.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_54_assoc" sourceRef="Note_54" targetRef="T9" />
    <bpmn:textAnnotation id="Note_55">
      <bpmn:text>Không đồng nhất "đã bàn giao" với "đã sửa chữa thành công".</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_55_assoc" sourceRef="Note_55" targetRef="g6" />
  </bpmn:process>
