      <bpmn:text>SƠ ĐỒ CHI TIẾT 1: Tiếp nhận yêu cầu và kiểm tra bảo hành tại quầy
Mô hình As-Is sơ bộ, dựng từ tài liệu công khai và hiểu biết của nhóm nghiên cứu. Đây không phải quy trình nội bộ chính thức của CellphoneS.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_2">
      <bpmn:text>Chú giải màu ghi chú</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_3">
      <bpmn:text>Xanh lá: có nguồn công khai</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_4">
      <bpmn:text>Cam: cần khảo sát</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_5">
      <bpmn:text>Tím: do nhóm nghiên cứu đưa ra</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_6">
      <bpmn:text>Xanh dương: khoảng thời gian cần đo</bpmn:text>
    </bpmn:textAnnotation>
