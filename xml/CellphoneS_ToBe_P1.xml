    <bpmn:textAnnotation id="Note_39">
      <bpmn:text>Khách có thể khai báo lỗi, số IMEI và đặt lịch trước khi đến, qua website, ứng dụng hoặc tổng đài. Tại quầy chỉ cần xác nhận lại.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_39_assoc" sourceRef="Note_39" targetRef="T1a" />
    <bpmn:textAnnotation id="Note_40">
      <bpmn:text>Mốc thời gian được lưu: lúc khách đến cửa hàng, lúc khách được tiếp, lúc có hướng xử lý.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_40_assoc" sourceRef="Note_40" targetRef="S" />
    <bpmn:textAnnotation id="Note_41">
      <bpmn:text>Hướng dẫn sao lưu được đưa lên đầu. Khách chuẩn bị máy trong lúc nhân viên tra cứu và tư vấn.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_41_assoc" sourceRef="Note_41" targetRef="T1b" />
    <bpmn:textAnnotation id="Note_42">
      <bpmn:text>Cần khảo sát: công cụ tra cứu hiện tại đã hiện đủ nhóm sản phẩm, quyền lợi và nơi bảo hành chưa.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_42_assoc" sourceRef="Note_42" targetRef="T2" />
    <bpmn:textAnnotation id="Note_43">
      <bpmn:text>Thứ tự tra cứu thay thế: số điện thoại mua hàng, hóa đơn, số Seri trên máy. Vẫn không ra thì người được chỉ định quyết định.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_43_assoc" sourceRef="Note_43" targetRef="T2b" />
    <bpmn:textAnnotation id="Note_44">
      <bpmn:text>Phát hiện sớm dấu hiệu có thể khiến máy không được bảo hành.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_44_assoc" sourceRef="Note_44" targetRef="T3" />
    <bpmn:textAnnotation id="Note_45">
      <bpmn:text>Nơi xử lý cụ thể được chọn ngay tại quầy. Không có nơi phù hợp thì khách biết khi còn giữ máy.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_45_assoc" sourceRef="Note_45" targetRef="T4" />
    <bpmn:textAnnotation id="Note_46">
      <bpmn:text>Cần doanh nghiệp quyết định: ai kết luận lỗi thuộc nhà sản xuất tại cửa hàng; mốc 30 ngày tính đến ngày khách báo lỗi.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_46_assoc" sourceRef="Note_46" targetRef="g1" />
    <bpmn:textAnnotation id="Note_47">
      <bpmn:text>Khách chọn mang máy thẳng đến nơi sửa: bỏ được hai lần giao nhận giữa cửa hàng và nơi sửa.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_47_assoc" sourceRef="Note_47" targetRef="T8" />
    <bpmn:textAnnotation id="Note_48">
      <bpmn:text>Mức chi phí được ghi vào phiếu. Trong mức này thì bộ phận sửa chữa sửa luôn, không phải chờ khách trả lời.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_48_assoc" sourceRef="Note_48" targetRef="E_ok" />
    <bpmn:textAnnotation id="Note_49">
      <bpmn:text>Khách quay lại không phải làm lại từ đầu.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_49_assoc" sourceRef="Note_49" targetRef="T9" />
